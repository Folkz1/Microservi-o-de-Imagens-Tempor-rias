# URL base do serviço (configurar no Easypanel)
BASE_URL=https://instagram-images.seu-dominio.easypanel.host

# Porta do servidor
PORT=5000

# Tempo de expiração das imagens (em horas)
IMAGE_EXPIRY_HOURS=24

# Intervalo de limpeza automática (em minutos)
CLEANUP_INTERVAL_MINUTES=60

# API Key para autenticação (opcional)
# API_KEY=seu-token-secreto-aqui
